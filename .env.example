# EGrab - 环境变量配置模板
# 复制此文件为 .env 并填入你的实际 API Key
# cp .env.example .env

# ============================================================
# 代理配置（仅 OpenRouter 等海外 API 走代理，国产模型直连）
# ============================================================

# HTTP/HTTPS 代理地址（用于访问 OpenRouter / 海外API）
# 格式: http://ip:port 或 socks5://ip:port
HTTPS_PROXY=http://127.0.0.1:7890
HTTP_PROXY=http://127.0.0.1:7890

# 不走代理的地址列表（国产模型API全部直连）
# 逗号分隔，根域名即可覆盖所有子域名
NO_PROXY=moonshot.cn,bigmodel.cn,deepseek.com,xiaomimimo.com,minimaxi.com,stepfun.com,aliyuncs.com,localhost,127.0.0.1

# ============================================================
# OpenRouter (GPT / Claude / 其他无原厂API的模型) — 走代理
# ============================================================
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx

# ============================================================
# 国产模型原厂 API — 不走代理（已在 NO_PROXY 中排除）
# ============================================================

# Moonshot (Kimi-K2.6) - planner
MOONSHOT_API_KEY=sk-xxxxxxxxxxxx

# 智谱AI (GLM-5.1 / GLM-5-Turbo) - architect / frontend
ZHIPU_API_KEY=xxxxxxxxxxxx.xxxxxxxxxxxx

# DeepSeek (V4-Pro / V4-Flash) - backend / history
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxx

# 小米 MiMo (MiMo-v2.5-Pro) - tester
XIAOMI_API_KEY=sk-xxxxxxxxxxxx

# MiniMax (M2.7) - reviewer
MINIMAX_API_KEY=xxxxxxxxxxxx

# 阶跃星辰 Step (Step-3.5-Flash) - maintainer
STEPFUN_API_KEY=sk-xxxxxxxxxxxx

# 通义千问/DashScope (Qwen3.6-Max) - fallback
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxx
